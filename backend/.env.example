# -------------------------------------------------------------
# STechPay Environment Configuration Template
# -------------------------------------------------------------

# Django Core
DEBUG=False
DJANGO_SECRET_KEY=replace-this-with-a-secure-50-character-random-secret
ALLOWED_HOSTS=stechpay.your-school.edu.ng,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://stechpay.your-school.edu.ng,http://localhost:5173

# Institution & Frontend
INSTITUTION_NAME="School of Science and Technology"
FRONTEND_URL=https://stechpay.your-school.edu.ng

# Database (PostgreSQL recommended for production)
# Leave POSTGRES_DB empty to use local SQLite development fallback.
POSTGRES_DB=stechpay_db
POSTGRES_USER=stechpay_user
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Paystack Payment Gateway
# Set sk_test_... for test mode, sk_live_... for production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Transactional Email (Brevo / Sendinblue SMTP)
STECHPAY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
STECHPAY_EMAIL_HOST=smtp-relay.brevo.com
STECHPAY_EMAIL_PORT=587
STECHPAY_EMAIL_USERNAME=your_brevo_smtp_login
STECHPAY_EMAIL_PASSWORD=your_brevo_smtp_key
STECHPAY_EMAIL_TLS=True
DEFAULT_FROM_EMAIL=bursary@your-school.edu.ng

# API Rate Limiting
THROTTLE_ANON_RATE=120/minute
THROTTLE_USER_RATE=300/minute

# SSL & Security (Enabled when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
