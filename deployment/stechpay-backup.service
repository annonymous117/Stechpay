[Unit]
Description=Back up the Stechpay PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/stechpay.env
ExecStart=/usr/local/bin/stechpay-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/stechpay
