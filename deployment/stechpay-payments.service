[Unit]
Description=Stechpay payment reconciliation and notification worker
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/stechpay/backend
EnvironmentFile=/etc/stechpay.env
ExecStart=/srv/stechpay/backend/.venv/bin/python manage.py process_payments --limit 100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
