[Unit]
Description=Stechpay Django application
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/stechpay/backend
EnvironmentFile=/etc/stechpay.env
RuntimeDirectory=stechpay
RuntimeDirectoryMode=0755
ExecStartPre=/srv/stechpay/backend/.venv/bin/python manage.py check --deploy --fail-level WARNING
ExecStart=/srv/stechpay/backend/.venv/bin/gunicorn --workers 3 --bind unix:/run/stechpay/gunicorn.sock stechpay.wsgi:application
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
